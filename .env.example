PORT=3000

DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_BOT_TOKEN=
DISCORD_ROLE_DEVELOPER=1513095490554826882
# Domaine public servi par Nginx/Caddy (sans slash final)
BASE_URL=https://votre-domaine.fr
PUBLIC_BASE_URL=https://votre-domaine.fr
# Optionnel : force exactement l'URL callback inscrite dans le portail Discord.
# DISCORD_REDIRECT_URI=https://votre-domaine.fr/auth/discord/callback

# Traduction automatique du site
# Si LIBRETRANSLATE_URL est vide, seules les traductions locales/français sont disponibles.
TRANSLATION_PROVIDER=libretranslate
LIBRETRANSLATE_URL=http://127.0.0.1:5000
LIBRETRANSLATE_KEY=
# Evite de saturer LibreTranslate/Argos sur les grosses pages.
LIBRETRANSLATE_BATCH_SIZE=1
LIBRETRANSLATE_DELAY_MS=1500
I18N_TRANSLATION_TIMEOUT_MS=60000
I18N_MAX_MACHINE_TEXTS=400

# Recherche YouTube via Lavalink pour les musiques de profil.
# Ne mets jamais le mot de passe dans le frontend : le site proxy la recherche côté serveur.
LAVALINK_URL=http://77.93.141.48:25002
LAVALINK_PASSWORD=

# Lecture YouTube dans le navigateur.
# Lavalink sert a chercher/resoudre, yt-dlp sert a extraire un vrai flux audio web.
# Linux VPS: installe yt-dlp puis laisse YTDLP_PATH=yt-dlp
# Windows local: mets le chemin complet si yt-dlp n'est pas dans le PATH.
YTDLP_PATH=yt-dlp
YTDLP_FORMAT=bestaudio[ext=m4a]/bestaudio[ext=webm]/bestaudio/best
YTDLP_NO_CHECK_CERTIFICATES=1

# Webhook Discord pour les logs (optionnel)
DISCORD_WEBHOOK=https://discord.com/api/webhooks/...
